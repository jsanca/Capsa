# Capsa environment variable inventory
# Copy to .env and fill in values. Never commit .env to source control.

# ── Database ────────────────────────────────────────────────────────────────
# JDBC URL for the PostgreSQL instance.
# docker-compose.prod.yml connects to the co-located postgres service.
CAPSA_DB_URL=jdbc:postgresql://localhost:5432/capsa

# PostgreSQL credentials. Must match the POSTGRES_USER/PASSWORD in compose.
CAPSA_DB_USER=capsa
CAPSA_DB_PASSWORD=change-me

# ── OIDC ────────────────────────────────────────────────────────────────────
# Base URL of the OIDC provider (Keycloak, Auth0, etc.), without trailing slash.
# Example: https://auth.example.com/realms/capsa
CAPSA_OIDC_AUTH_SERVER_URL=

# Client ID registered with the OIDC provider. Defaults to "capsa" if unset.
CAPSA_OIDC_CLIENT_ID=capsa

# ── Bootstrap ────────────────────────────────────────────────────────────────
# One-time secret required to claim the initial ADMIN account.
# Generate with e.g.: openssl rand -hex 32
# Must be set before deploying. After bootstrap completes the token is inert.
# Production (Coolify): configure as a secret environment variable — never commit.
# Quarkus config key: capsa.bootstrap.token
CAPSA_BOOTSTRAP_TOKEN=
