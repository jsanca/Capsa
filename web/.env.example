# Capsa Server base URL (no trailing slash).
# Local development defaults to the docker-compose stack on http://localhost:8080.
VITE_CAPSA_API_URL=http://localhost:8080

# Development/stub OIDC access token used by the stub AuthProvider.
# The stub provider does NOT verify this token; the backend will only trust it
# when OIDC is disabled (%dev / %test profiles). Leave blank in %prod.
VITE_CAPSA_STUB_ACCESS_TOKEN=